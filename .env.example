# ─── LLM ───────────────────────────────────────────────────────────
LLM_BASE_URL=
LLM_MODEL=gpt-oss-120b

# ─── Per-Agent Models ──────────────────────────────────────────────
# Override the model for individual agents (defaults shown).
# If unset, each agent uses its hardcoded default.
ARCHITECT_MODEL=gpt-oss-120b
PRODUCT_MANAGER_MODEL=llama-3-3-70b-instruct
DBA_MODEL=llama-3-3-70b-instruct
TEAM_LEADER_MODEL=gemma-3-27b-it
DEVOPS_MODEL=mistral-small-3-1-24b-instruct-2503
CODEBASE_ANALYZER_MODEL=gpt-oss-120b
PRINCIPAL_DEV_MODEL=llama-3-3-70b-instruct
SENIOR_DEV_MODEL=mistral-small-3-1-24b-instruct-2503
JUNIOR_DEV_MODEL=gpt-oss-20b
QA_MODEL=gpt-oss-20b

# ─── OAuth2 client-credentials (for LLM token) ────────────────────
OAUTH_TOKEN_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# ─── Run behaviour ─────────────────────────────────────────────────
# autonomous | human (default: human)
RUN_MODE=human
# Max bug-fix iterations before stopping the loop (default: 3)
MAX_BUGFIX_ITERATIONS=3
# Allow hard reset to origin/<branch> when ff/rebase fail during workspace sync (default: true)
# WORKSPACE_SYNC_ALLOW_RESET=true
# Max file-change entries injected into the dev context prompt (default: 60)
# DEV_CONTEXT_FILE_CHANGES_LIMIT=60
# Max parallel developer agents (default: 2; higher only lengthens throttle queues)
MAX_CONCURRENT_DEVS=2
# Delay (ms) between dispatching batches of branches (default: 5000)
INTER_BATCH_DELAY_MS=5000

# ─── Paths ─────────────────────────────────────────────────────────
# Base directory for generated products (default: ./generated-projects)
GENERATED_PROJECTS_DIR=./generated-projects
# Run logs and state snapshots (default: ./outputs)
OUTPUTS_DIR=./outputs

# ─── Docker ────────────────────────────────────────────────────────
# Optional: Docker Engine endpoint (default: local socket)
DOCKER_HOST=

# ─── DevOps Verification ───────────────────────────────────────────
# Actually build/run Docker artifacts and health-check after DevOps agent finishes (default: true)
# DEVOPS_VERIFY_ENABLED=true
# Timeout (ms) for each shell step during deployment verification (default: 600000 = 10 min)
# DEVOPS_VERIFY_TIMEOUT_MS=600000
# First host port for mapping container EXPOSE ports (default: 18080)
# DEVOPS_VERIFY_BASE_PORT=18080
# Number of retries for each health-check URL (default: 5)
# DEVOPS_HEALTH_RETRIES=5
# Delay (ms) between health-check retries (default: 3000)
# DEVOPS_HEALTH_DELAY_MS=3000
# Tear down containers during finalize (default: true)
# DEVOPS_TEARDOWN=true
# Allow E2E test failures to trigger a bugfix loop (default: false)
# E2E_BUGFIX_ENABLED=false

# ─── Agent Output Validation ───────────────────────────────────────
# Number of repair attempts when agent output fails schema validation (0 disables)
# AGENT_OUTPUT_REPAIR_ATTEMPTS=1

# ─── Context Budget ─────────────────────────────────────────────────
# Use compact summarisers instead of raw JSON.stringify dumps (default: true)
# Set to false to restore old verbatim behaviour for A/B testing
# CONTEXT_COMPACT=true
# Hard character budget for assembled context per agent prompt (default: 24000)
# CONTEXT_MAX_CHARS=24000
# Max chars for clipped descriptions in architecture summaries (default: 200)
# CONTEXT_MAX_DESC_CHARS=200
# Strip deep description fields from injected JSON Schema (default: true)
# RESPONSE_SCHEMA_COMPACT=true

# ─── Quality Gates ─────────────────────────────────────────────────
# Enable multi-language quality gates in PR workflow and QA (default: true)
# QUALITY_GATES_ENABLED=true
# Steps to run (comma-separated: install,build,lint,test)
# QUALITY_GATE_STEPS=install,build,lint,test
# Timeout (ms) per quality gate step (default: 300000 = 5 min)
# QUALITY_GATE_TIMEOUT_MS=300000
# Fail the gate when a stack's toolchain is missing (default: false — missing = skipped)
# QUALITY_GATE_STRICT_TOOLCHAIN=false

# ─── Playwright MCP ────────────────────────────────────────────────
# Override the command/args to launch the Playwright MCP server
PLAYWRIGHT_MCP_CMD=npx
PLAYWRIGHT_MCP_ARGS=@playwright/mcp@latest --headless

# ─── GitHub ────────────────────────────────────────────────────────
# GitHub PAT or app token for PR operations (requires 'repo' scope)
GITHUB_TOKEN=
# Repository owner (org or user)
GITHUB_OWNER=
# Repository name
GITHUB_REPO=
# Git committer identity
GIT_USER_NAME=
# Git committer email
GIT_USER_EMAIL=
# Default branch name (default: main)
GIT_DEFAULT_BRANCH=main
# Max PR review rounds before escalation (default: 5)
MAX_REVIEW_ITERATIONS=5
# Timeout (ms) for `npm install` in PR worktrees (default: 300000 = 5 min)
# PR_TEST_INSTALL_TIMEOUT_MS=300000
# Timeout (ms) for `npm test` in PR worktrees (default: 180000 = 3 min)
# PR_TEST_TIMEOUT_MS=180000
# Automated repair attempts when pre-PR tests fail (default: 1, 0 disables)
# PR_TEST_REPAIR_ATTEMPTS=1

# ─── GitHub Project (multi-repo targeting) ─────────────────────────
# Optional: separate PAT for project-specific repos (falls back to GITHUB_TOKEN)
GITHUB_PROJECT_TOKEN=
# Optional: owner for project-specific repos (falls back to GITHUB_OWNER)
GITHUB_PROJECT_OWNER=

# ─── Agent Recursion & Tool Budgets ────────────────────────────────
# Recursion limit for tool-using pipeline agents (qa-unit, qa-e2e, devops, codebase-analyzer)
# TOOL_PIPELINE_RECURSION_LIMIT=60
# Max total tool calls for tool-using pipeline agents (loop-guard ceiling)
# TOOL_PIPELINE_MAX_TOOL_CALLS=25
# Reviewer recursion limit (raised so the loop guard fires before LangGraph's hard error)
# REVIEWER_RECURSION_LIMIT=26
# Max total tool calls for reviewer agents (must stay below REVIEWER_RECURSION_LIMIT / 2)
# REVIEWER_MAX_TOOL_CALLS=8

# ─── LLM Throttle & Rate-Limit Protection ─────────────────────────
# Gateway request-per-minute quotas observed per model:
#   gpt-oss-120b: 20, gpt-oss-20b: 20, mistral-small-3-1-24b: 30,
#   llama-3-2-3b: 30, llama-3-3-70b: 30
# Set LLM_MIN_REQUEST_INTERVAL_MS to 60000 / RPM of the model you run
# (e.g. 3000 for a 20-RPM model). The 400 ms default is only safe for
# gateways without a per-minute request quota.
# Process-wide max concurrent LLM requests (semaphore)
# LLM_MAX_CONCURRENT_REQUESTS=2
# Minimum spacing between LLM request starts (ms)
# LLM_MIN_REQUEST_INTERVAL_MS=400
# Maximum adaptive interval ceiling (ms, raised on 429, decays on success)
# LLM_MAX_REQUEST_INTERVAL_MS=5000
# Base cooldown on 429 (doubles per consecutive 429)
# LLM_COOLDOWN_BASE_MS=5000
# Maximum cooldown duration (ms)
# LLM_COOLDOWN_MAX_MS=90000
# retryWithBackoff: max attempts for whole-agent retries
# LLM_RETRY_ATTEMPTS=8
# retryWithBackoff: initial backoff delay (ms)
# LLM_RETRY_INITIAL_MS=8000
# retryWithBackoff: maximum delay cap (ms)
# LLM_RETRY_MAX_MS=120000

# ─── Dashboard ─────────────────────────────────────────────────────
DASHBOARD_PORT=3000
