# ─── LLM ───────────────────────────────────────────────────────────
LLM_BASE_URL=
LLM_MODEL=gpt-oss-120b

# ─── Per-Agent Models ──────────────────────────────────────────────
# Override the model for individual agents (defaults shown).
# If unset, each agent uses its hardcoded default.
ARCHITECT_MODEL=gpt-oss-120b
PRODUCT_MANAGER_MODEL=llama-3-3-70b-instruct
DBA_MODEL=llama-3-3-70b-instruct
TEAM_LEADER_MODEL=gemma-3-27b-it
DEVOPS_MODEL=mistral-small-3-1-24b-instruct-2503
CODEBASE_ANALYZER_MODEL=gpt-oss-120b
PRINCIPAL_DEV_MODEL=llama-3-3-70b-instruct
SENIOR_DEV_MODEL=mistral-small-3-1-24b-instruct-2503
JUNIOR_DEV_MODEL=gpt-oss-20b
QA_MODEL=gpt-oss-20b

# ─── Multi-Provider LLM (Sub-Plan 20) ──────────────────────────────
# Direct API keys — when ANY of these are set, OAuth (below) is NOT required.
# OpenAI API key. When set, OpenAI agents use this directly instead of OAuth.
# If empty, falls back to the OAuth client-credentials flow (OAUTH_TOKEN_URL).
# OPENAI_API_KEY=
# Anthropic API key for Claude models. Required when any agent model matches /claude|anthropic/i.
# ANTHROPIC_API_KEY=
# Google API key for Gemini models. Required when any agent model matches /gemini/i.
# GOOGLE_API_KEY=
# Optional base URL override for Anthropic (for proxies)
# ANTHROPIC_BASE_URL=
# Optional base URL override for Google (for proxies)
# GOOGLE_BASE_URL=
# Provider detection: 'auto' (detect from model name) | 'openai' (force all through OpenAI endpoint)
# LLM_PROVIDER_DETECTION=auto
# ── Anthropic prompt caching (Plan 22, D1/D2) ──
# Place cache_control breakpoints on the system prompt (which also covers the tool
# schemas, since Anthropic serialises tools before system), the task message, and the
# stable history prefix. Without this every call re-bills a byte-identical ~6 kB
# preamble: the pacmanclaude run billed 2.32M input tokens for 99.7K output. (default: true)
# ANTHROPIC_PROMPT_CACHE_ENABLED=true
# Log an ERROR if Anthropic reports zero cache reads after SANITY_ASSERT_CACHE_AFTER
# calls. A cache that silently never engages is expensive and otherwise invisible. (default: true)
# SANITY_ASSERT_CACHE=true
# SANITY_ASSERT_CACHE_AFTER=20

# ─── OAuth2 client-credentials (for LLM token) ────────────────────
# Only required when using OpenAI-compatible models WITHOUT OPENAI_API_KEY set.
# When any direct API key above is configured, these can be left empty.
OAUTH_TOKEN_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# ─── Run behaviour ─────────────────────────────────────────────────
# autonomous | human (default: human)
RUN_MODE=human
# Max bug-fix iterations before stopping the loop (default: 3)
MAX_BUGFIX_ITERATIONS=3
# Allow hard reset to origin/<branch> when ff/rebase fail during workspace sync (default: true)
# WORKSPACE_SYNC_ALLOW_RESET=true
# Timeout (ms) for git subcommands that hit the network: fetch/push/pull/clone/ls-remote.
# Local subcommands stay at 30s. (default: 120000)
# GIT_NETWORK_TIMEOUT_MS=120000
# Max file-change entries injected into the dev context prompt (default: 60)
# DEV_CONTEXT_FILE_CHANGES_LIMIT=60
# Max parallel developer agents (default: 2; higher only lengthens throttle queues)
MAX_CONCURRENT_DEVS=2
# Delay (ms) between dispatching batches of branches (default: 5000)
INTER_BATCH_DELAY_MS=5000

# ─── Paths ─────────────────────────────────────────────────────────
# Base directory for generated products (default: ./generated-projects)
GENERATED_PROJECTS_DIR=./generated-projects
# Run logs and state snapshots (default: ./outputs)
OUTPUTS_DIR=./outputs

# ─── Docker ────────────────────────────────────────────────────────
# Optional: Docker Engine endpoint (default: local socket)
DOCKER_HOST=

# ─── DevOps Verification ───────────────────────────────────────────
# Actually build/run Docker artifacts and health-check after DevOps agent finishes (default: true)
# DEVOPS_VERIFY_ENABLED=true
# Timeout (ms) for each shell step during deployment verification (default: 600000 = 10 min)
# DEVOPS_VERIFY_TIMEOUT_MS=600000
# First host port for mapping container EXPOSE ports (default: 18080)
# DEVOPS_VERIFY_BASE_PORT=18080
# Number of retries for each health-check URL (default: 5)
# DEVOPS_HEALTH_RETRIES=5
# Delay (ms) between health-check retries (default: 3000)
# DEVOPS_HEALTH_DELAY_MS=3000
# Tear down containers during finalize (default: true)
# DEVOPS_TEARDOWN=true
# Allow E2E test failures to trigger a bugfix loop.
# Was false — flipped to true in Sub-Plan 11 because E2E never ran in either
# post-mortem run, so the cost concern was hypothetical.
# E2E_BUGFIX_ENABLED=true

# ─── Run Budget ────────────────────────────────────────────────────
# 0 disables the limit. All three are checked; the closest one binds.
# MAX_RUN_TOKENS=0
# MAX_RUN_COST_USD=150  (was 0/unlimited; set to $150 now that raised budgets are safe with early-halt)
# MAX_RUN_WALL_MS=18000000  (was 0/unlimited; set to 5 hours)
# Utilisation thresholds for degradation ladder (default: warn=0.70, degrade=0.90)
# BUDGET_WARN_AT=0.70
# BUDGET_DEGRADE_AT=0.90

# ─── LLM Output Limits ─────────────────────────────────────────────
# Hard output-token ceiling for all agents (default 16000)
# LLM_MAX_OUTPUT_TOKENS=16000
# Output-token ceiling for planning agents (architect, PM, DBA, TL) (default 32000)
# PLANNING_MAX_OUTPUT_TOKENS=32000
# Per-request LLM timeout in ms (default 300000 = 5 min)
# LLM_REQUEST_TIMEOUT_MS=300000

# ─── Agent Output Validation ───────────────────────────────────────
# Number of repair attempts when agent output fails schema validation (default 2)
# AGENT_OUTPUT_REPAIR_ATTEMPTS=2
# Continuation attempts when JSON output is truncated mid-array (default 3)
# AGENT_OUTPUT_CONTINUATION_ATTEMPTS=3

# ─── Context Budget ─────────────────────────────────────────────────
# Hard character budget for assembled context per agent prompt (default: 24000)
# CONTEXT_MAX_CHARS=24000
# Max chars for clipped descriptions in architecture summaries (default: 200)
# CONTEXT_MAX_DESC_CHARS=200
# Strip deep description fields from injected JSON Schema (default: true)
# RESPONSE_SCHEMA_COMPACT=true
# Strip ALL descriptions and noise from injected JSON Schema for maximum token savings (default: true)
# RESPONSE_SCHEMA_STRIP_ALL_DESCRIPTIONS=true

# ─── Context Compaction ─────────────────────────────────────────────
# Max characters any single tool result may contribute to agent history (default: 6000)
# MAX_TOOL_RESULT_CHARS=10000  (was 6000; raised because truncated reads forced re-reads)
# Number of most-recent tool results kept verbatim in ReAct history (default: 2)
# HISTORY_KEEP_RECENT_TOOL_RESULTS=4  (was 2; raised because agents re-read stubbed-out results)
# Enable the preModelHook that compacts ReAct history before each LLM call (default: true)
# HISTORY_COMPACTION_ENABLED=true
# Strip streaming residue (*_delta blocks, id-less tool_use blocks) from AIMessage
# content before every LLM call. Guards against the Anthropic 400
# "tool_use.id: Field required", including on checkpoint resume. (default: true)
# SANITIZE_STREAM_BLOCKS=true
# Number of most-recent MODEL TURNS whose tool results are kept verbatim (default: 3).
# This is the primary recent-window control; HISTORY_KEEP_RECENT_TOOL_RESULTS is a lower
# bound. Counting individual results is wrong for models that batch tool calls: with
# 8–11 parallel calls per turn, "keep the last 4 results" preserved only ONE turn, so
# agents re-read files they had just read and exhausted their tool budget doing it.
# (Plan 22, B4)
# HISTORY_KEEP_RECENT_TURNS=3
# Number of most-recent write turns whose tool-call arguments are NEVER elided (default: 2).
# The model needs its last writes verbatim to diff against, and this is the window where
# placeholder imitation was observed. (Plan 22, B3)
# HISTORY_KEEP_RECENT_WRITE_ARGS=2
# Hard character ceiling for the assembled ReAct history passed to the LLM (default: 30000)
# HISTORY_MAX_CHARS=60000  (was 30000; over-aggressive compaction caused re-reads costing more tokens)
# Inject a distilled conventions digest in the prompt instead of read_file (default: true)
# CONVENTIONS_INLINE_DIGEST=true
# Give developer agents git tools; PR workflow already commits/pushes for them (default: false)
# DEV_GIT_TOOLS_ENABLED=false
# Use the short persona variant for developer agents (default: true)
# PERSONA_COMPACT=true
# Respawn a dev agent with summarised handoff instead of poisoning tools at ceiling (default: true)
# AGENT_RESPAWN_ENABLED=true
# Max respawn generations per logical dev task (default: 2)
# AGENT_RESPAWN_MAX_GENERATIONS=4  (was 2; raised because real handoffs make respawn productive)
# Input-token threshold that triggers a respawn on the next step (default: 14000)
# AGENT_RESPAWN_TOKEN_THRESHOLD=14000

# ─── Quality Gates ─────────────────────────────────────────────────
# Enable multi-language quality gates in PR workflow and QA (default: true)
# QUALITY_GATES_ENABLED=true
# Steps to run (comma-separated: install,typecheck,build,lint,test)
# QUALITY_GATE_STEPS=install,typecheck,build,lint,test
# Timeout (ms) per quality gate step (default: 300000 = 5 min)
# QUALITY_GATE_TIMEOUT_MS=300000
# Fail the gate when a stack's toolchain is missing (default: true — set to false only for local experiments)
# QUALITY_GATE_STRICT_TOOLCHAIN=true
# Max directory depth scanned when detecting stack roots in monorepos (default: 3)
# QUALITY_GATE_SCAN_DEPTH=3
# Max stack roots gated per run — guards pathological directory trees (default: 8)
# QUALITY_GATE_MAX_ROOTS=8

# ─── Product Verification ──────────────────────────────────────────
# Enable artifact / import-resolution / smoke verification of the generated product (default: true)
# PRODUCT_VERIFY_ENABLED=true
# Minimum total bytes a build must emit before it counts as a real build (default: 2048)
# PRODUCT_MIN_ARTIFACT_BYTES=2048
# Max source files scanned by the import-resolution check (default: 2000)
# PRODUCT_RESOLVE_MAX_FILES=2000
# First host port used by the smoke server — probes upward when busy (default: 18190)
# PRODUCT_SMOKE_BASE_PORT=18190
# Timeout (ms) for the smoke server to become ready and answer (default: 60000)
# PRODUCT_SMOKE_TIMEOUT_MS=60000

# ─── Gate Integrity (Sub-Plan 02) ──────────────────────────────────
# Baseline-diff enforcement for gate tampering: 'off' | 'warn' | 'enforce' (default: enforce)
# GATE_INTEGRITY_MODE=enforce
# Protect configuration files from agent writes: 'off' | 'warn' | 'deny' (default: deny)
# FS_CONFIG_PROTECTION=deny
# Reject test files whose subject is not reachable from an application entry point (default: true)
# REJECT_TRIVIAL_TESTS=true
# Delete test files the integrity gate flags as trivial (default: false — report only).
# Trivial-test detection is a heuristic over an import graph. Deleting source on a
# heuristic is not proportionate: in the pacmanclaude run it removed four legitimate
# Playwright e2e specs plus one unit test, pushed the deletion, and the reviewer then
# filed "[MAJOR] No test files exist". When true, only CRITICAL findings are deletable
# and every body is archived to outputs/<run>/deleted-tests/ first. (Plan 22, F3)
# GATE_INTEGRITY_DELETE_TRIVIAL_TESTS=false

# ─── Run Acceptance (Sub-Plan 03) ──────────────────────────────────
# What happens when the product does not satisfy the acceptance gate.
# 'halt' = stop early on failure, 'finalize' = run to end but report honestly, 'legacy' = always 'completed'
# RUN_FAIL_POLICY=halt
# Minimum number of executed tests for the TESTS acceptance criterion (default: 1)
# ACCEPT_MIN_TESTS=1
# Treat the SMOKE criterion as required (default: true)
# ACCEPT_REQUIRE_SMOKE=true
# Consecutive zero-output dispatch rounds before marking a run unrecoverable (default: 2)
# UNRECOVERABLE_ZERO_ROUNDS=2

# ─── Security Gates ────────────────────────────────────────────────
# Enable security gates (secret scan, dependency audit, licence check) in QA (default: true)
# SECURITY_GATES_ENABLED=true
# When true, critical security findings become Bugs that feed the bug-fix loop (default: false)
# SECURITY_GATE_BLOCKING=false
# Run scanForSecrets on PR worktrees before opening PRs; critical secrets block the merge (default: false)
# SECURITY_GATE_IN_PR=false
# Enable deep dependency audit (e.g. OWASP for Maven — downloads large CVE DB) (default: false)
# SECURITY_DEEP_AUDIT=false
# Comma-separated SPDX licence IDs to deny (e.g. GPL-3.0,AGPL-3.0; empty = no check)
# LICENCE_DENYLIST=

# ─── Shell Tool ────────────────────────────────────────────────────
# Allow agents to run shell commands on the host (default: true)
# SHELL_ALLOW_HOST=true
# Default timeout (seconds) for shell commands when none specified (default: 60)
# SHELL_DEFAULT_TIMEOUT_S=60
# Maximum timeout (seconds) — agent-requested values are clamped to this (default: 900)
# SHELL_MAX_TIMEOUT_S=900

# ─── Playwright MCP ────────────────────────────────────────────────
# Override the command/args to launch the Playwright MCP server
PLAYWRIGHT_MCP_CMD=npx
PLAYWRIGHT_MCP_ARGS=@playwright/mcp@latest --headless

# ─── GitHub ────────────────────────────────────────────────────────
# GitHub PAT or app token for PR operations (requires 'repo' scope)
GITHUB_TOKEN=
# Repository owner (org or user)
GITHUB_OWNER=
# Repository name
GITHUB_REPO=
# Git committer identity
GIT_USER_NAME=
# Git committer email
GIT_USER_EMAIL=
# Default branch name (default: main)
GIT_DEFAULT_BRANCH=main
# Max PR review rounds before escalation (default: 5)
MAX_REVIEW_ITERATIONS=5
# Timeout (ms) for `npm install` in PR worktrees (default: 300000 = 5 min)
# PR_TEST_INSTALL_TIMEOUT_MS=300000
# Timeout (ms) for `npm test` in PR worktrees (default: 180000 = 3 min)
# PR_TEST_TIMEOUT_MS=180000
# Automated repair attempts when pre-PR tests fail (default: 1, 0 disables)
# PR_TEST_REPAIR_ATTEMPTS=1

# ─── GitHub Project (multi-repo targeting) ─────────────────────────
# Optional: separate PAT for project-specific repos (falls back to GITHUB_TOKEN)
GITHUB_PROJECT_TOKEN=
# Optional: owner for project-specific repos (falls back to GITHUB_OWNER)
GITHUB_PROJECT_OWNER=

# ─── Agent Recursion & Tool Budgets ────────────────────────────────
# Recursion limit for tool-using pipeline agents (qa-unit, qa-e2e, devops, codebase-analyzer)
# TOOL_PIPELINE_RECURSION_LIMIT=120  (was 60; qa-unit was poisoned at 6-7 calls in all QA phases)
# Max total tool calls for tool-using pipeline agents (loop-guard ceiling)
# TOOL_PIPELINE_MAX_TOOL_CALLS=50  (was 25; qa-unit was poisoned at 6-7 calls in all QA phases)
# Reviewer recursion limit (raised so the loop guard fires before LangGraph's hard error)
# REVIEWER_RECURSION_LIMIT=40  (was 26; reviewers abstained on recursion limits)
# Max total tool calls for reviewer agents (must stay below REVIEWER_RECURSION_LIMIT / 2)
# REVIEWER_MAX_TOOL_CALLS=14  (was 8; reviewers abstained on budget exhaustion)

# ─── LLM Throttle & Rate-Limit Protection ─────────────────────────
# Gateway request-per-minute quotas observed per model:
#   gpt-oss-120b: 20, gpt-oss-20b: 20, mistral-small-3-1-24b: 30,
#   llama-3-2-3b: 30, llama-3-3-70b: 30
# Set LLM_MIN_REQUEST_INTERVAL_MS to 60000 / RPM of the model you run
# (e.g. 3000 for a 20-RPM model). The 400 ms default is only safe for
# gateways without a per-minute request quota.
# Process-wide max concurrent LLM requests (semaphore)
# LLM_MAX_CONCURRENT_REQUESTS=2
# Minimum spacing between LLM request starts (ms)
# LLM_MIN_REQUEST_INTERVAL_MS=400
# Maximum adaptive interval ceiling (ms, raised on 429, decays on success)
# LLM_MAX_REQUEST_INTERVAL_MS=5000
# Base cooldown on 429 (doubles per consecutive 429)
# LLM_COOLDOWN_BASE_MS=5000
# Maximum cooldown duration (ms)
# LLM_COOLDOWN_MAX_MS=90000
# retryWithBackoff: max attempts for whole-agent retries
# LLM_RETRY_ATTEMPTS=8
# retryWithBackoff: initial backoff delay (ms)
# LLM_RETRY_INITIAL_MS=8000
# retryWithBackoff: maximum delay cap (ms)
# LLM_RETRY_MAX_MS=120000

# ─── HITL / Checkpointing ──────────────────────────────────────────
# Persist graph checkpoints to disk so a HITL or crashed run can survive a server restart (default: false)
# CHECKPOINT_PERSIST=false

# ─── Observability ─────────────────────────────────────────────────
# Max events kept in the ring buffer for backfilling reconnecting dashboards (default: 500)
# EVENT_BUFFER_SIZE=500

# ─── Plan Coverage (Sub-Plan 04) ───────────────────────────────────
# Plan coverage enforcement: off | warn | enforce (default: enforce)
# PLAN_COVERAGE_MODE=enforce
# Gap-repair attempts when the plan does not cover every story/task (default: 2)
# PLAN_COVERAGE_REPAIR_ATTEMPTS=2
# Context char budget for the Team Leader (receives full AC) (default: 48000)
# TEAM_LEADER_CONTEXT_MAX_CHARS=48000

# ─── Architecture Contract (Sub-Plan 05) ───────────────────────────
# Enforce the Architect's repo contract: off | warn | enforce (default: enforce)
# REPO_CONTRACT_MODE=enforce
# Cap on declared modules in the contract (default: 60)
# REPO_CONTRACT_MAX_MODULES=60
# Create typed interface stubs during scaffold (default: true)
# CONTRACT_STUB_SCAFFOLD=true
# Char budget for the contract section in agent prompts (default: 6000)
# CONTRACT_PROMPT_MAX_CHARS=6000

# ─── Requirements Traceability (Sub-Plan 10) ───────────────────────
# Minimum verified AC coverage % for the AC_COVERAGE acceptance criterion. Only source:'executed' tests count. 0 = off. (default: 70)
# MIN_AC_COVERAGE_PCT=70
# Minimum implemented (merged code exists) AC %. A weaker but mandatory bar. 0 = off. (default: 90)
# MIN_AC_IMPLEMENTED_PCT=90
# Max bugs synthesised for uncovered criteria (default: 25)
# MIN_AC_COVERAGE_MAX_BUGS=25
# Write outputs/<run>/traceability.json alongside the markdown (default: true)
# TRACEABILITY_JSON=true

# ─── LLM Cassettes (offline determinism) ───────────────────────────
# Cassette mode: off (default), record, or replay
# LLM_CASSETTE_MODE=off
# Name of the cassette file (without extension, stored in tests/cassettes/)
# CASSETTE_NAME=
# Behaviour on a replay miss: strict (throws, default) or passthrough (calls real LLM)
# LLM_CASSETTE_ON_MISS=strict
# Warn when a cassette file exceeds this size in MB (default: 25)
# CASSETTE_MAX_MB=25
# GitHub mode: live (default) or local (offline, bare-repo backed — no GitHub account needed)
# GITHUB_MODE=live

# ─── PR Workflow / Work Preservation (Sub-Plan 06) ──────────────────
# Max failed worktrees retained under .worktrees-failed/ for salvage (default: 10)
# WORKTREE_SALVAGE_MAX=10
# Export git format-patch bundles for every branch that fails to merge (default: true)
# PR_SALVAGE_PATCHES=true
# Dev-agent attempts at resolving a merge conflict before reporting blocked (default: 1)
# MERGE_CONFLICT_FIX_ATTEMPTS=1
# Max times a single assignment may be re-dispatched (default: 3)
# ASSIGNMENT_MAX_ATTEMPTS=3
# Only the scaffold branch may modify shared root config files (default: true)
# CONFIG_OWNERSHIP_SCAFFOLD_ONLY=true

# ─── Review & Merge Policy (Sub-Plan 07) ───────────────────────────
# Merge policy: strict (evidence required) | permissive | legacy (pre-Plan-19)
# REVIEW_MERGE_POLICY=strict
# Genuine approvals required to merge (abstentions do not count) (default: 1)
# REVIEW_QUORUM=1
# Retries when every reviewer abstained (schema error / recursion limit) (default: 1)
# REVIEW_ABSTAIN_RETRIES=1
# Extra tool calls granted to an escalated developer (default: 10)
# ESCALATION_TOOL_CALL_BONUS=10
# Convert unresolved major review comments into Bugs for the bugfix loop (default: true)
# REVIEW_MAJORS_TO_BUGS=true

# ─── Strong Model PR Fixer (Sub-Plan 20) ───────────────────────────
# Model for the strong fixer agent (e.g. 'claude-opus-4.6', 'gpt-4o').
# Falls back to PRINCIPAL_DEV_MODEL when empty. Combined with the multi-provider
# abstraction, setting this to a Claude or Gemini model name automatically routes
# to the correct provider.
# STRONG_FIXER_MODEL=
# Enable/disable the strong fixer (default: true)
# STRONG_FIXER_ENABLED=true
# Turn ceiling for the strong fixer agent (default: 40).
# Plan 22 A2 changed the unit: this bounds MODEL TURNS, not individual tool calls.
# Read/write/shell pools come from the principal budgets plus headroom.
# STRONG_FIXER_MAX_TOOL_CALLS=40
# PR exhaustion strategy — what happens when max review iterations are reached:
# 'escalate-then-fix' = run rank-based escalation first, then strong fixer if still unresolved (default)
# 'fix-only' = skip escalation, go straight to strong fixer
# 'escalate-only' = keep existing escalation behaviour, no strong fixer (backward-compatible)
# PR_EXHAUSTION_STRATEGY=escalate-then-fix

# ─── Agent Budgets & Context (Sub-Plan 08) ──────────────────────────
# Max files listed in the injected workspace snapshot (default: 400)
# SNAPSHOT_MAX_FILES=400
# Char budget for the injected workspace snapshot (default: 8000)
# SNAPSHOT_MAX_CHARS=8000
# Extra read calls granted when an agent is making verified progress (writes) (default: 10)
# LOOP_GUARD_PROGRESS_BONUS=10
# Absolute per-invocation tool-call ceiling (default: 140).
# Was 80 — raised because the per-category and per-turn ceilings are now the binding
# constraints, and 80 calls is only ~8 turns for a model that batches 9–11 per turn.
# LOOP_GUARD_HARD_CEILING=140
# Per-rank read/write/shell/TURN budgets (JSON override, default: empty = use built-in).
# A partial entry is merged over the defaults, so {"junior":{"turns":26}} changes only
# the junior turn ceiling. Built-in defaults (Plan 22, A1):
#   principal { reads: 60, writes: 30, shell: 14, turns: 28 }
#   senior    { reads: 50, writes: 25, shell: 12, turns: 24 }
#   junior    { reads: 40, writes: 20, shell: 12, turns: 20 }
# Until Plan 22 this variable — and the whole budget system it configures — was dead:
# buildAgent() always passed a single flat call ceiling, so a Claude agent that batched
# 11 reads into one turn spent its entire budget in 5 turns and could no longer write.
# TOOL_BUDGETS_JSON=
# Terminal-guidance responses an agent may receive before the factory withholds tools
# from the next model call, forcing the ReAct loop to end (default: 2). The pacmanclaude
# run burned 3–4 further ~10k-token turns per generation after the budget was gone,
# because nothing stopped the loop. (Plan 22, A4)
# MAX_POST_EXHAUSTION_CALLS=2
# Write agent mission reports and the architecture contract into the generated project
# repo (default: false — they go to outputs/<run>/agents/ instead, and docs/agents/ +
# .agent/ are gitignored). Committing them produced six "chore: pipeline artifacts"
# commits on a single feature branch and put them in every PR diff. (Plan 22, G4)
# AGENT_ARTIFACTS_IN_REPO=false
# Invocation-level retries for transient LLM/network failures (default: 1)
# AGENT_INVOKE_RETRIES=1
# Reconcile agent-claimed fileChanges against the worktree and drop phantoms (default: true)
# RECONCILE_FILE_CHANGES=true
# Dev recursion limit (was 58; raised to 140 — loop guard is the binding constraint now)
# DEV_RECURSION_LIMIT=140

# ─── QA Real Execution (Sub-Plan 09) ─────────────────────────────
# Enforce test-sufficiency rules (min counts, coverage floor, per-story coverage) (default: true)
# QA_ENFORCE_SUFFICIENCY=true
# Minimum total non-trivial executed tests. 0 = derive as max(5, storyCount) (default: 0)
# QA_MIN_TOTAL_TESTS=0
# Minimum tagged passing tests per user story (default: 1)
# QA_MIN_TESTS_PER_STORY=1
# Minimum line-coverage percentage. 0 = off (default: 40)
# QA_MIN_COVERAGE_PCT=40
# Timeout (ms) for a single test-runner invocation (default: 600000 = 10 min)
# QA_TEST_TIMEOUT_MS=600000
# Max qa-unit invocations per QA phase (one per story/module) (default: 12)
# QA_MAX_INVOCATIONS=12
# Route QA-authored tests through the PR workflow on a dedicated test branch (default: true)
# QA_TESTS_VIA_PR=true

# ─── DevOps & E2E Hardening (Sub-Plan 11) ─────────────────────────
# Serve the built product locally for E2E when no Docker services are available (default: true)
# E2E_ALLOW_LOCAL_SERVER=true
# Make the E2E acceptance criterion required (default: false)
# ACCEPT_REQUIRE_E2E=false
# Playwright MCP startup budget in ms (default: 60000)
# PLAYWRIGHT_MCP_STARTUP_TIMEOUT_MS=60000
# Connection retries for the Playwright MCP server (default: 2)
# PLAYWRIGHT_MCP_CONNECT_RETRIES=2
# Auto-install Playwright browsers when missing (default: true)
# PLAYWRIGHT_AUTO_INSTALL=true
# Generate a deterministic Dockerfile/compose when the DevOps agent fails (default: true)
# DEVOPS_FALLBACK_ENABLED=true

# ─── Observability & Regression (Sub-Plan 12) ──────────────────────
# Events kept in the ring buffer (was 500 — both post-mortem runs saturated it) (default: 5000)
# EVENT_BUFFER_SIZE=5000
# High-severity events retained regardless of ring eviction (default: 500)
# EVENT_PRIORITY_BUFFER_SIZE=500
# Write outputs/<run>/ledger.jsonl and run-report.md (default: true)
# RUN_LEDGER_ENABLED=true
# Dump every agent's full LangGraph result (messages + structuredResponse) to
# outputs/<run>/full-responses/<seq>-<agent>-<phase>.json plus an index.jsonl
# summary. This is the only record of what a model ACTUALLY returned — keep it on
# when diagnosing empty/odd agent output (default: true)
# FULL_RESPONSE_LOG_ENABLED=true
# Directory name under the run output dir for those dumps (default: full-responses)
# FULL_RESPONSE_LOG_DIR_NAME=full-responses
# Max characters per dump file, 0 = unlimited (default: 0)
# FULL_RESPONSE_LOG_MAX_CHARS=0
# Run-invariant enforcement: 'off' | 'warn' | 'strict' (default: warn)
# RUN_INVARIANTS_MODE=warn

# ─── Continue Run (Plan 23) ──────────────────────────────────────────
# Include previous run's token usage in budget calculations when continuing (default: true)
# CONTINUE_TOKEN_CARRY_FORWARD=true
# Auto-fix git state issues (worktree cleanup, branch sync) before resuming (default: true)
# CONTINUE_GIT_RECONCILE=true
# Close open GitHub PRs from previous run that will be re-dispatched (default: true)
# CONTINUE_CLOSE_STALE_PRS=true

# ─── Dashboard ─────────────────────────────────────────────────────
DASHBOARD_PORT=3000
