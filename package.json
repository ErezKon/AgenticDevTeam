{
  "name": "agentic-dev-team",
  "version": "1.0.0",
  "description": "Multi-agent AI system that ingests requirements and autonomously designs, builds, tests, and containerizes a complete software product.",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "test": "jest --runInBand --verbose",
    "test:oauth": "jest --runInBand --verbose --testPathPattern=oauth",
    "test:greenfield": "jest --runInBand --verbose --testPathPattern=greenfield",
    "test:maintain": "jest --runInBand --verbose --testPathPattern=maintain",
    "test:unit": "jest --runInBand --verbose --testPathIgnorePatterns='greenfield|maintain|pipeline-replay'",
    "test:regression": "jest --runInBand --verbose --testPathPattern=regression-plan19",
    "test:replay": "jest --runInBand --verbose --testPathPattern=pipeline-replay",
    "record:cassette": "LLM_CASSETTE_MODE=record CASSETTE_NAME=greenfield-smoke GITHUB_MODE=local tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/anthropic": "^1.5.4",
    "@langchain/core": "^1.2.5",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.5.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.0",
    "cors": "^2.8.5",
    "dockerode": "^4.0.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonrepair": "^3.14.1",
    "langchain": "^1.5.5",
    "mammoth": "^1.9.0",
    "pdf-parse": "^1.1.1",
    "ws": "^8.18.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^3.3.38",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
